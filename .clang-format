---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
# Formatting must not depend on the checkout's line endings: with the default DeriveLineEnding a
# CRLF working copy can push exactly-100-column lines over the limit, so clang-format keeps
# rewriting the same file on every run (and a commit can silently carry unformatted output).
LineEnding: LF
IndentWidth: 4
AccessModifierOffset: -4
PointerAlignment: Left
DerivePointerAlignment: false
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
SeparateDefinitionBlocks: Always
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<flowget/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<[a-z_]+>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
SortIncludes: CaseSensitive
